// Cloudflare Workers – nur statische Assets, kein Worker-Code, keine Datenbank.
// Deploy: `npx wrangler deploy` (Cloudflare Git-Integration führt das automatisch aus).
{
  "name": "konzept60",
  "compatibility_date": "2026-11-01",
  // Vorschau-Builds für Branches/PRs (`npx wrangler preview`) brauchen diesen Block, er darf leer sein
  "previews": {},
  "assets": {
    "directory": "./",
    // Unbekannte Pfade → 404.html mit Status 404 (statt leerer Antwort)
    "not_found_handling": "404-page"
  }
}
